    given-names: Yu-Chun
    affiliation: "Department of Life Sciences, National Chung Hsing University"
    orcid: "https://orcid.org/0009-0006-1635-119X"
  - family-names: Hu
    given-names: Fang-Shuo
    affiliation: "Natural History Museum Denmark, University of Copenhagen"
    orcid: "https://orcid.org/0000-0003-1269-8904"
keywords:
  - biodiversity
  - biological occurrence records
  - cartography
  - topography
  - reproducible research
